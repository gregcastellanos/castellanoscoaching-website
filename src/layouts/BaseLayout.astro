---
import '@fontsource-variable/inter';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import Motion from '../components/Motion.astro';
import { SITE } from '../data/site';

interface Props {
 title: string;
 description: string;
 /** Optional JSON-LD object(s) rendered into the head. */
 jsonLd?: object | object[];
 ogType?: 'website' | 'article';
}

const { title, description, jsonLd, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-cover.png', Astro.site);
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/castellanos-compass-logo.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#012255" />
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="Sonoma County, California" />

  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {
   jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
   ))
  }
 </head>
 <body>
  <video
   class="site-background-video"
   data-src="/castellanos-background.mp4"
   preload="none"
   muted
   loop
   playsinline
   aria-hidden="true"
   tabindex="-1"
  ></video>
  <script>
   // Load the ambient background video only after the page has rendered,
   // and never for reduced-motion or data-saver users.
   const bgVideo = document.querySelector<HTMLVideoElement>('.site-background-video');
   const conn = (navigator as any).connection;
   if (
    bgVideo &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !(conn && conn.saveData)
   ) {
    window.addEventListener('load', () => {
     bgVideo.src = bgVideo.dataset.src ?? '';
     bgVideo.play().catch(() => {});
    });
   }
  </script>
  <a href="#main" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main">
   <slot />
  </main>
  <Footer />
  <MobileCta />
  <Motion />
 </body>
</html>
