---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const metaTitle =
 'Family Resources & Free Guide | Castellanos Coaching';
const metaDescription = `Free family guide and quick executive function strategies for home, from Castellanos Coaching. Practical starting points you can use today.`;

const jsonLd = breadcrumbSchema([
 { name: 'Home', path: '/' },
 { name: 'Resources', path: '/resources/' },
]);

const quickIdeas = [
 {
  title: 'The 5-Minute Start',
  body: `Do not commit to finishing the task. Commit to five minutes. Starting is often the hardest part, and action usually creates more motivation than waiting to feel ready.`,
 },
 {
  title: 'Make the first step smaller',
  body: `“Clean your room” is too big. Start with five pieces of trash, one load of laundry, or one clear surface. When a task is not starting, the first step is usually still too large.`,
 },
 {
  title: 'Find somewhere in between',
  body: `Perfection and giving up are not the only choices. Look for the smaller version that still moves things forward. Partial progress counts and often creates momentum.`,
 },
 {
  title: 'Use a body double',
  body: `Some tasks are easier when another person is simply nearby. They do not need to take over. Their presence can add structure, accountability, and enough momentum to begin.`,
 },
 {
  title: 'Reset without shame',
  body: `A missed day does not erase the system. Restart at the next opportunity instead of waiting for Monday, next month, or the perfect moment. Recovery is part of the skill.`,
 },
 {
  title: 'The Ownership Ladder',
  body: `Move a skill from “I do it for you,” to “we do it together,” to “you do it with support,” and finally, “you own it.” Independence grows through gradual transfer, not sudden withdrawal.`,
 },
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
 <PageHero
  eyebrow="Resources"
  title="Useful starting points, free to take"
  lede="Start here and take what works, even if we never meet."
 />

 <section class="section">
  <div class="wrap">
   <div class="guide card">
    <div>
     <p class="eyebrow">Free guide</p>
     <h2>The Family Launch Checklist</h2>
     <p>
      A practical guide for parents of neurodivergent teens and young adults:
      core independence skills, what to support first, and how to hand over ownership.
     </p>
     <p class="guide__note">
      Download the checklist now, or open the live Google Doc if you prefer
      to view it online.
     </p>
     <div class="btn-row guide__actions">
      <a href="/the-family-launch-checklist.docx" class="btn btn--primary" download>
       Download the Checklist
      </a>
      <a
       href="https://docs.google.com/document/d/1ss3S8KuYkU2PDxXQ00o1IuPeWnQ9laTClLv5JG40Q4M/edit?usp=sharing"
       class="btn btn--outline"
       target="_blank"
       rel="noopener noreferrer">Open Google Doc</a
      >
     </div>
    </div>
    <div class="guide__visual" aria-hidden="true">
     <div class="guide__mock">
      <span class="guide__mock-title">The Family<br />Launch<br />Checklist</span>
      <span class="guide__mock-byline">Castellanos Coaching</span>
     </div>
    </div>
   </div>

   <div class="section-head" style="margin-top: var(--space-section-sm);">
    <p class="eyebrow">Tools I use in coaching</p>
    <h2>Simple tools for starting and following through</h2>
    <p class="lede">
     Simple tools I use with clients to make starting, following through,
     and building independence more manageable.
    </p>
   </div>
   <div class="ideas-grid">
    {
     quickIdeas.map((idea) => (
      <div class="card idea-card">
       <h3>{idea.title}</h3>
       <p>{idea.body}</p>
      </div>
     ))
    }
   </div>
  </div>
 </section>

 <CtaBand
  title="Want ideas built for your actual kid?"
  body="A free consultation gives you a read on your specific situation."
 />
</BaseLayout>

<style>
 .guide {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: clamp(1.15rem, 0.9rem + 1.55vw, 2.35rem);
  align-items: center;
  background: var(--surface-paper);
  border-color: var(--line);
 }

 .guide h2 {
  font-size: var(--text-2xl);
  margin-bottom: 0.5rem;
 }

 .guide p + p {
  margin-top: 0.55rem;
 }

 .guide__actions {
  margin-top: 0.9rem;
 }

 .guide__note {
  font-size: 0.95rem;
 }

 .guide__visual {
  display: grid;
  place-items: center;
 }

 .guide__mock {
  width: min(100%, 13rem);
  aspect-ratio: 3 / 4;
  background: var(--navy);
  border-radius: 8px;
  box-shadow: var(--shadow-lift);
  padding: 1.5rem 1.25rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
 }

 .guide__mock-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 560;
  line-height: 1.25;
  color: var(--white);
 }

 .guide__mock-byline {
  font-size: 0.7rem;
  font-weight: 640;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold);
 }

 .ideas-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.85rem;
 }

 .idea-card h3 {
  font-size: var(--text-lg);
  margin-bottom: 0.35rem;
 }

 .idea-card p {
  font-size: 1rem;
 }

 @media (max-width: 900px) {
  .ideas-grid {
   grid-template-columns: 1fr 1fr;
  }
 }

 @media (max-width: 700px) {
  .guide,
  .ideas-grid {
   grid-template-columns: 1fr;
  }

  .guide__visual {
   display: none;
  }
 }
</style>
