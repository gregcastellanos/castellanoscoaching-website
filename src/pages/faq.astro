---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqItem from '../components/FaqItem.astro';
import CtaBand from '../components/CtaBand.astro';
import { BOOKING, SITE } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../data/schema';

const metaTitle =
 'Coaching FAQ | Castellanos Coaching, Marin & Bay Area';
const metaDescription = `Answers about remote coaching, scheduling, pricing, parent support, and how coaching works for Bay Area and Northern California families.`;

interface Faq {
 q: string;
 a: string[];
}

interface FaqGroup {
 group: string;
 items: Faq[];
}

const groups: FaqGroup[] = [
 {
  group: 'About coaching',
  items: [
   {
    q: 'What is executive function coaching?',
    a: [
     `One-on-one support for planning, starting tasks, managing time, staying organized, and following through. We build real systems, test them, and adjust until they hold.`,
    ],
   },
   {
    q: 'Is coaching therapy?',
    a: [
     `No. Coaching is educational mentoring and skill-building. It can complement clinical care, but it does not replace therapy, medical care, or mental-health support.`,
    ],
   },
   {
    q: 'How is coaching different from tutoring?',
    a: [
     `Tutoring teaches content. Coaching builds the operating system around it: planning the week, starting the work, communicating early, and recovering when things slip.`,
    ],
   },
   {
    q: 'Do you only work with people who have a diagnosis?',
    a: [
     `No diagnosis is required. Coaching starts with how life is actually going, not with labels.`,
    ],
   },
  ],
 },
 {
  group: 'Fit and clients',
  items: [
   {
    q: 'What ages do you work with?',
    a: [
     `Children, teens, college students, young adults, adults, parents, and families.`,
    ],
   },
   {
    q: 'My teen refuses help. Now what?',
    a: [
          `Start with parent coaching, or try one low-pressure conversation between Gregory and your teen. No lecture. No forced enthusiasm. Just one honest meeting.`,
    ],
   },
   {
    q: 'Do you work with autistic adults?',
    a: [
     `Yes. Many adult clients want support with work, routines, independence, communication, and social connection.`,
    ],
   },
  ],
 },
 {
  group: 'Logistics',
  items: [
   {
    q: 'Are sessions remote or in person?',
    a: [
     `Most coaching sessions are held remotely through Google Meet. Remote sessions make it easier to maintain consistency, work with clients across a wider geographic area, and practice real-life skills from the client's own environment. Limited in-person coaching may be available in Marin, Sonoma County, and nearby areas.`,
    ],
   },
   {
    q: 'Do you offer evening appointments?',
    a: [
     `Flexible daytime scheduling is encouraged whenever possible. A limited number of evening appointments are available for working parents and clients who cannot meet during the day.`,
    ],
   },
   {
    q: 'Who is remote daytime coaching a good fit for?',
    a: [
     `Remote daytime coaching can be especially helpful for young adults, college students, homeschool students, clients with flexible work or school schedules, and parents who want to meet privately during the day.`,
    ],
   },
   {
    q: 'How long does coaching take?',
    a: [
     `Most clients meet weekly. Some work for a semester; others need longer support. Coaching tapers as independence grows.`,
    ],
   },
   {
    q: 'Do you work with parents too?',
    a: [
     `Yes. Parent and family coaching can happen alongside individual coaching or on its own. Gregory helps families reduce conflict, build shared systems, and support independence without carrying every task.`,
    ],
   },
   {
    q: 'What does coaching cost?',
    a: [
     `Pricing is discussed during the free consultation and depends on the format and frequency of coaching. Rates are not listed online.`,
    ],
   },
   {
    q: 'How do parents stay in the loop?',
    a: [
     `Families get clear communication about direction and progress. Privacy boundaries are agreed on up front, especially with teens.`,
    ],
   },
  ],
 },
 {
  group: 'Getting started',
  items: [
   {
    q: 'What happens in the free consultation?',
    a: [
     `A relaxed 20–30 minute phone or Google Meet call about what is going on, what you have tried, and where to start. Daytime and limited evening consultation times are available.`,
    ],
   },
   {
   q: 'How do I book?',
   a: [
     `Use the online scheduler, call ${SITE.phone}, or email ${SITE.email}.`,
    ],
   },
  ],
 },
];

const allFaqs = groups.flatMap((g) => g.items);
const jsonLd = [
 faqSchema(allFaqs.map((f) => ({ q: f.q, a: f.a.join(' ') }))),
 breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
 ]),
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
 <PageHero
  eyebrow="FAQ"
  title="Honest answers to fair questions"
  lede="Clear answers before you reach out. If your question is not here, ask directly."
 />

 <section class="section">
  <div class="wrap faq-wrap">
   {
    groups.map((g) => (
     <div class="faq-group">
      <h2>{g.group}</h2>
      <div>
       {g.items.map((item) => (
        <FaqItem question={item.q}>
         {item.a.map((para) => (
          <p>{para}</p>
         ))}
        </FaqItem>
       ))}
      </div>
     </div>
    ))
   }

   <div class="faq-more card">
    <h2>Still wondering about something?</h2>
    <p>
     Call <a href={SITE.phoneHref}>{SITE.phone}</a>, email
     <a href={`mailto:${SITE.email}`}> {SITE.email}</a>, or schedule the
     free consultation and ask everything at once.
    </p>
    <a
     href={BOOKING.url}
     class="btn btn--primary"
     target={BOOKING.target}
     rel={BOOKING.rel}
     aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
    >
   </div>
  </div>
 </section>

 <CtaBand />
</BaseLayout>

<style>
 .faq-wrap {
  max-width: 52rem;
 }

 .faq-group {
  margin-bottom: clamp(1.85rem, 1.45rem + 1.45vw, 3rem);
 }

 .faq-group h2 {
  font-size: var(--text-xl);
  margin-bottom: 0.45rem;
  padding-bottom: 0.55rem;
  border-bottom: 2px solid var(--gold);
  display: inline-block;
 }

 .faq-more {
  display: grid;
  gap: 0.75rem;
  justify-items: start;
  background: var(--teal-tint);
  border-color: transparent;
 }

 .faq-more h2 {
  font-size: var(--text-lg);
 }
</style>
