---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbSchema } from '../data/schema';

const metaTitle =
 'The Castellanos Compass™ | Castellanos Coaching';
const metaDescription = `The Castellanos Compass™ is Gregory Castellanos's coaching framework: Clarity, Alignment, Foundation, and Expansion.`;

const points = [
 {
  dir: 'North',
  name: 'Clarity',
  tagline: 'Understand what is happening now.',
  body: [
   `We start by understanding strengths, challenges, goals, and current reality. The result is a shared picture of what matters most right now.`,
  ],
  looks: [
   'A strengths and challenges map in plain language',
   'Goals the client actually said yes to',
   'Two or three priorities, not twenty',
  ],
 },
 {
  dir: 'East',
  name: 'Alignment',
  tagline: 'Build trust and shared understanding.',
  body: [
   `We build trust, communication, motivation, and shared understanding. Goals work better when the client has a real voice in them.`,
  ],
  looks: [
   'A client who shows up willingly (sometimes a first)',
   'Working agreements, how sessions run, what stays private',
   'Parents and coach on the same page, with the client at the center',
  ],
 },
 {
  dir: 'South',
  name: 'Foundation',
  tagline: 'Create practical systems that hold.',
  body: [
   `We create routines, executive functioning strategies, and daily-life supports that fit the person and work in real life.`,
  ],
  looks: [
   'A small number of systems, actually used',
   'Routines that recover after a bad day instead of collapsing',
   'Visible wins: things planned, started, finished',
  ],
 },
 {
  dir: 'West',
  name: 'Expansion',
  tagline: 'Grow confidence and independence.',
  body: [
   `We increase independence, confidence, purpose, relationships, and long-term growth. Gregory steps back as the client takes ownership.`,
  ],
  looks: [
   'Skills transferring to new situations without re-teaching',
   'The client setting their own next goals',
   'Coaching tapering because it worked',
  ],
 },
];

const jsonLd = breadcrumbSchema([
 { name: 'Home', path: '/' },
 { name: 'The Castellanos Compass™', path: '/castellanos-compass/' },
]);
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
 <PageHero
  title='The Castellanos Compass<sup class="tm">™</sup>'
  lede="A practical four-stage framework for building clarity, trust, useful systems, and meaningful independence."
 />

 <section class="section">
  <div class="wrap compass-intro">
   <div class="compass-intro__visual" aria-hidden="true">
    <img src="/castellanos-compass-logo.png" alt="" width="200" height="220" loading="lazy" />
   </div>
      <div class="prose">
    <p class="lede">
     The Castellanos Compass™ gives every coaching relationship a clear
     direction without forcing every client through the same program.
    </p>
    <p>
     It reflects more than 15 years of teaching and coaching
     neurodivergent people. <strong>Understanding comes before strategy.
     Trust comes before systems. Systems create room for growth.</strong>
    </p>
    <p>
     Every engagement moves through all four stages. How long each takes
     depends entirely on the person, and circling back is a feature,
     not a failure.
    </p>
    <p>
     <strong>The Compass is cyclical.</strong> Clients revisit each
     direction at deeper levels as they grow.
    </p>
   </div>
  </div>
 </section>

 <section class="section section--sand" aria-label="The four stages of The Castellanos Compass™">
  <div class="wrap">
   <div class="points">
    {
     points.map((p, i) => (
      <article class="point card">
       <header class="point__header">
        <h2>
         <span class="point__dir">{p.dir}</span>
         <span class="point__divider" aria-hidden="true"></span>
         <span>{p.name}</span>
        </h2>
        <p class="point__tagline">{p.tagline}</p>
       </header>
       <div class="point__body prose">
        {p.body.map((para) => (
         <p>{para}</p>
        ))}
       </div>
       <div class="point__looks">
        <h3>What it looks like</h3>
        <ul class="check-list">
         {p.looks.map((item) => (
          <li>{item}</li>
         ))}
        </ul>
       </div>
      </article>
     ))
    }
   </div>
  </div>
 </section>

 <CtaBand
  title='Start with The Castellanos Compass<sup class="tm">™</sup>.'
  body="In a free consultation, Gregory will give you an honest read on where things stand, and what Clarity would look like for your situation."
 />
</BaseLayout>

<style>
  .compass-intro {
    display: grid;
    grid-template-columns: 0.55fr 1.45fr;
    gap: clamp(2rem, 1.5rem + 3vw, 4.5rem);
    align-items: center;
    max-width: 60rem;
    margin-inline: auto;
  }

  .compass-intro__visual {
    display: grid;
    place-items: center;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    aspect-ratio: 1;
    background:
      radial-gradient(closest-side, rgba(200, 154, 43, 0.08), transparent 80%),
      var(--white);
    box-shadow: var(--shadow-card);
  }

  .compass-intro__visual img {
    width: min(70%, 9rem);
  }

  @media (max-width: 760px) {
    .compass-intro {
      grid-template-columns: 1fr;
    }

    .compass-intro__visual {
      width: min(55%, 12rem);
      margin-inline: auto;
    }
  }

 .points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
 }

 .point {
  display: grid;
  gap: 1.25rem;
  align-content: start;
 }

 .point h2 {
  font-size: var(--text-xl);
  margin-top: 0.35rem;
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
 }

 .point__dir {
  color: var(--gold-deep);
 }

 .point__divider {
  width: 1.25rem;
  height: 2px;
  background: var(--gold);
  flex: none;
 }

 .point__tagline {
  margin-top: 0.4rem;
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--text-md);
  color: var(--ink-soft);
 }

 .point__body p {
  font-size: 1rem;
 }

 .point__looks h3 {
  font-size: 0.85rem;
  font-weight: 680;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-family: var(--font-body);
  color: var(--sage-deep);
  margin-bottom: 0.75rem;
 }

 .point__looks .check-list {
  font-size: 0.98rem;
 }

 @media (max-width: 860px) {
    .points {
      grid-template-columns: 1fr;
  }
 }
</style>
