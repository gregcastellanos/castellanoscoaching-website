---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompassMark from '../components/CompassMark.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import HillsDivider from '../components/HillsDivider.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqItem from '../components/FaqItem.astro';
import CtaBand from '../components/CtaBand.astro';
import { BOOKING, SERVICE_MODEL, SERVICES } from '../data/site';
import { businessSchema, websiteSchema } from '../data/schema';

const metaTitle =
 'Executive Function Coaching | Bay Area & Remote';
const metaDescription =
 'Executive function, academic, and life skills coaching for neurodivergent kids, teens, and adults in Sonoma County, the Bay Area, and Northern California.';

const compassSteps = [
 {
  dir: 'North',
  name: 'Clarity',
  body: 'We start with the real picture: strengths, challenges, goals, interests, and the places where daily life keeps breaking down.',
 },
 {
  dir: 'East',
  name: 'Alignment',
  body: 'Coaching works best when the client has a say. We build trust, communication, motivation, and shared understanding.',
 },
 {
  dir: 'South',
  name: 'Foundation',
  body: 'We create practical, brain-compatible systems for planning, time, routines, communication, school, work, home life, and follow-through.',
 },
 {
  dir: 'West',
  name: 'Expansion',
  body: 'We widen toward real-world independence: confidence, purpose, relationships, leadership, and self-direction.',
 },
];

const audiences = [
 {
 title: 'For Children',
  body: `Early support for confidence, communication, routines, friendships, and emotional regulation before struggles get bigger.`,
  link: { href: '/services/academic-coaching/', label: 'Children’s coaching' },
 },
 {
 title: 'For parents',
  body: `You are tired of being the alarm clock, project manager, and backup brain. Coaching gives your child another trusted mentor.`,
  link: { href: '/services/parent-family-coaching/', label: 'Parent & family coaching' },
 },
 {
 title: 'For teens & students',
  body: `You are not lazy or broken. We build systems for school, routines, communication, and follow-through.`,
  link: { href: '/services/academic-coaching/', label: 'Academic coaching' },
 },
 {
 title: 'For adults',
  body: `Work, money, relationships, home, and attention can be a lot. Coaching turns overwhelm into next steps.`,
  link: { href: '/services/independence-life-skills-coaching/', label: 'Independence coaching' },
 },
];

const serviceIcons: Record<string, string> = {
 'executive-function-coaching':
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
 'academic-coaching':
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H20v13H6.5A2.5 2.5 0 0 0 4 19.5V19z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-2.5"/></svg>',
 'social-skills-coaching':
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12h.01M12 12h.01M16 12h.01"/><path d="M21 12a8.5 8.5 0 0 1-12.4 7.5L4 21l1.6-4.3A8.5 8.5 0 1 1 21 12z"/></svg>',
 'independence-life-skills-coaching':
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/></svg>',
 'parent-family-coaching':
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z"/></svg>',
};

const testimonials = [
 {
  quote:
   'Greg helped me stop overthinking and actually take steps. We worked on school, jobs, track, and planning my future in a way that felt real.',
  name: 'Logan D.',
 },
 {
  quote:
   'Greg helps me work on being more independent. I have a real job now, I go to concerts, and I\u2019m learning how to handle more things on my own.',
  name: 'Alex G.',
 },
 {
  quote:
   'Greg actually listened to what I wanted. He helped me think about school, work, and real-life stuff without making me feel talked down to.',
  name: 'Rune C.',
 },
 {
  quote:
   'Greg helped me get organized and start doing things instead of avoiding them. He made everything feel less overwhelming.',
  name: 'Seth A.',
 },
];

const faqPreview = [
 {
  q: 'What is executive function coaching?',
  a: `It is hands-on support for planning, starting, organizing, managing time, and following through. We build real systems together, then adjust them until they fit real life.`,
 },
 {
  q: 'Is coaching therapy?',
  a: `No. Coaching is educational mentoring and skill-building. It can complement clinical care, but it does not replace therapy, medical care, or mental-health support.`,
 },
 {
  q: 'Do you work remotely or in person?',
  a: 'Most coaching is remote through Google Meet. Limited in-person coaching may be available in Marin, Sonoma County, and nearby areas when it fits the client and schedule.',
 },
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={[businessSchema, websiteSchema]}>
 <section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
   <div class="hero__copy">
    <p class="eyebrow">Coaching for bright, capable brains that work differently.</p>
    <h1 id="hero-title">
     <span>Clarity.</span>
     <span>Systems.</span>
     <span>Independence.</span>
    </h1>
    <p class="hero__lede">
     Gregory Castellanos helps neurodivergent children, teens, adults, and
     people with special needs build practical systems for school, work,
     relationships, communication, routines, and daily life.
    </p>
    <p class="hero__location">
     Most coaching is remote through Google Meet, with flexible daytime
     scheduling and limited evening and in-person availability.
    </p>
    <div class="btn-row">
     <a
      href={BOOKING.url}
      class="btn btn--primary"
      target={BOOKING.target}
      rel={BOOKING.rel}
      data-sticky-cta-anchor
      aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
     >
     <a href="/about/" class="btn btn--outline">Meet Gregory</a>
    </div>
    <p class="hero__booking-note">{BOOKING.reassurance}</p>
    <ul class="hero__trust" aria-label="Credentials">
     <li>15+ years supporting neurodivergent learners</li>
     <li>Master of Arts in Teaching (M.A.T.)</li>
     <li>Remote first, with limited in-person options</li>
     <li>Creator of The Castellanos Compass™</li>
    </ul>
   </div>
   <figure class="hero__portrait">
    <picture>
     <source srcset="/greg-hero.webp" type="image/webp" />
     <img
      src="/greg-hero.jpg"
      alt="Gregory Castellanos, educator and executive function coach"
      width="1200"
      height="675"
      loading="eager"
      fetchpriority="high"
     />
    </picture>
   </figure>
  </div>
  <HillsDivider />
 </section>

 <section class="how-strip" aria-label="How coaching works">
  <div class="wrap how-strip__grid">
   <div><strong>Free 20–30 minute call</strong><span>Start here and take what works, even if we never meet.</span></div>
   <div><strong>A plan that fits your brain</strong><span>Choose practical priorities together.</span></div>
   <div><strong>Weekly coaching</strong><span>Meet remotely through Google Meet, with limited in-person options.</span></div>
  </div>
 </section>

 <section class="section section--sm" aria-labelledby="remote-title">
  <div class="wrap remote-card card">
   <div>
    <p class="eyebrow">Remote coaching</p>
    <h2 id="remote-title">Remote coaching that fits real life</h2>
    <p>
     Most coaching sessions are available remotely through Google Meet,
     making it easier for clients and families to receive consistent support
     without added travel. Flexible daytime appointments are available
     throughout the week, with limited evening and in-person options when needed.
    </p>
   </div>
   <div class="remote-card__action">
    <a
     href={BOOKING.url}
     class="btn btn--primary"
     target={BOOKING.target}
     rel={BOOKING.rel}
     aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
    >
    <p>Daytime and limited evening consultation times are available.</p>
   </div>
  </div>
 </section>

 <section class="section" aria-labelledby="who-title">
  <div class="wrap">
   <div class="section-head">
    <p class="eyebrow">Who this is for</p>
    <h2 id="who-title">Who Gregory Works With</h2>
    <p class="lede">
     Coaching is for bright, capable people who need systems that fit how they think:
     children, teens, adults, and families navigating ADHD, autism, learning
     differences, anxiety, school avoidance, motivation, social struggles, and life transitions.
    </p>
   </div>
   <div class="audience-grid">
    {
     audiences.map((a) => (
      <div class="card audience-card">
       <h3>{a.title}</h3>
       <p>{a.body}</p>
              <a href={a.link.href} class="audience-card__link">{a.link.label}</a>
      </div>
     ))
    }
   </div>
  </div>
 </section>

 <section class="section section--sand" aria-labelledby="services-title">
  <div class="wrap">
   <div class="section-head">
    <p class="eyebrow">Coaching services</p>
    <h2 id="services-title">Coaching that connects the dots</h2>
    <p class="lede">
     Most clients need more than one category. Gregory blends executive
     function, academics, social communication, life skills, and family
     support into one practical plan.
    </p>
   </div>
   <div class="services-grid">
    {
     SERVICES.map((s) => (
      <ServiceCard
       href={`/services/${s.slug}/`}
       title={s.title}
       description={s.short}
      >
       <Fragment set:html={serviceIcons[s.slug]} />
      </ServiceCard>
     ))
    }
    <ServiceCard
     href={BOOKING.url}
     title="Not sure where to start?"
     description="Start with a free conversation. Gregory will help you figure out what kind of support actually fits."
     label={BOOKING.shortLabel}
     target={BOOKING.target}
     rel={BOOKING.rel}
     ariaLabel={BOOKING.ariaLabel}
    >
     <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M9.8 9a2.4 2.4 0 0 1 4.7.7c0 1.8-2.5 2-2.5 3.8" />
      <path d="M12 17h.01" />
     </svg>
    </ServiceCard>
   </div>
  </div>
 </section>

 <section class="section section--ink" aria-labelledby="not-tutoring-title">
  <div class="wrap not-tutoring">
   <div>
    <p class="eyebrow">Why coaching</p>
    <h2 id="not-tutoring-title">This is not tutoring with a new label.</h2>
    <p class="lede">
     Tutoring helps with content. Coaching builds the operating system
     around the content: time, tasks, confidence, communication, and
     recovery when things slip.
    </p>
   </div>
   <div class="not-tutoring__points">
    <div>
     <h3>Skills, not answers</h3>
     <p>
      Every system is built to be run by the client: planning,
      prioritizing, communicating, and recovering when things slip.
     </p>
    </div>
    <div>
     <h3>Strengths-based, not deficit-based</h3>
     <p>
      We start from what already works: interests, energy patterns,
      and the client’s actual way of thinking.
     </p>
    </div>
    <div>
     <h3>Real life, not worksheets</h3>
     <p>
      Coaching uses real materials: the backpack, calendar, job
      application, or conversation that needs practice.
     </p>
    </div>
   </div>
  </div>
 </section>

 <section class="section" aria-labelledby="compass-title">
  <div class="wrap compass-section">
   <div class="compass-intro">
    <span class="compass-logo-tile"><CompassMark size={62} /></span>
    <h2 id="compass-title">The Castellanos Compass<sup class="tm">™</sup></h2>
    <p class="lede">
     A practical framework for clarity, trust, systems, and independence.
    </p>
    <p class="compass-summary">
     Understand the person. Build trust. Create systems. Expand independence.
    </p>
    <p class="compass-cycle">
     Clients revisit each direction as they grow.
    </p>
   </div>
   <ol class="compass-steps">
     {
      compassSteps.map((step) => (
       <li>
        <span class="compass-steps__num">{step.dir}</span>
        <h3>{step.name}</h3>
        <p>{step.body}</p>
       </li>
      ))
     }
   </ol>
   <div class="compass-action">
    <a href="/castellanos-compass/" class="btn btn--outline">Explore The Castellanos Compass<sup class="tm">™</sup></a>
   </div>
  </div>
 </section>

 <section class="section section--sand" aria-labelledby="why-title">
  <div class="wrap why-grid">
   <div>
    <p class="eyebrow">Why families choose Gregory</p>
    <h2 id="why-title">A mentor who gets it and gets things moving</h2>
    <div class="why-points">
     <p>
      <strong>Deep, real experience.</strong> 15+ years teaching and
      coaching neurodivergent learners in classrooms, STEAM programs,
      and one-on-one work.
     </p>
     <p>
      <strong>Respect first.</strong> Clients are not problems to fix.
      Gregory listens first and builds from what they care about.
     </p>
     <p>
      <strong>Practical to the core.</strong> Sessions end with something
      real: a plan, system, practice conversation, or task started.
     </p>
     <p>
      <strong>Partnership with parents.</strong> Families get clear
      communication and practical guidance that lowers the temperature at home.
     </p>
    </div>
    <a href="/about/" class="btn btn--ink">Meet Gregory</a>
   </div>
   <TestimonialSlider items={testimonials} />
  </div>
 </section>

 <section class="section" aria-labelledby="local-title">
  <div class="wrap">
   <div class="section-head section-head--center">
    <p class="eyebrow">Where we work</p>
    <h2 id="local-title">Remote first, with local options when appropriate</h2>
    <p class="lede">
     {SERVICE_MODEL.remote} {SERVICE_MODEL.inPerson}
    </p>
   </div>
   <div class="local-grid">
    <div class="card local-card">
     <h3>Remote Coaching</h3>
     <p>
      Consistent Google Meet sessions for executive function, academics,
      independence, social skills, and real-life problem solving.
     </p>
    </div>
    <div class="card local-card">
     <h3>Daytime Appointments</h3>
     <p>
      A strong fit for young adults, college students, homeschool students,
      flexible work schedules, and parent consultations.
     </p>
    </div>
    <div class="card local-card">
     <h3>Limited Evenings</h3>
     <p>
      A limited number of evening appointments remain available for working
      parents and clients who cannot meet during the day.
     </p>
    </div>
    <div class="card local-card">
     <h3>Limited In Person</h3>
     <p>
      In-person coaching may be available in Marin, Sonoma County, and nearby
      areas when location, needs, and scheduling line up.
     </p>
    </div>
   </div>
  </div>
 </section>

 <section class="section section--sand" aria-labelledby="faq-title">
  <div class="wrap faq-preview">
   <div class="section-head">
    <p class="eyebrow">Good questions</p>
    <h2 id="faq-title">What parents and clients usually ask first</h2>
   </div>
   <div>
    {
     faqPreview.map((item) => (
      <FaqItem question={item.q}>
       <p>{item.a}</p>
      </FaqItem>
     ))
    }
    <p class="faq-preview__more">
          <a href="/faq/">Read all frequently asked questions</a>
    </p>
   </div>
  </div>
 </section>

 <CtaBand />
</BaseLayout>

<style>
 .hero {
  background: var(--surface-white);
  border-bottom: 1px solid var(--line);
 }

 .hero__inner {
 display: grid;
 grid-template-columns: 0.9fr 1.1fr;
 align-items: center;
  gap: clamp(2rem, 1rem + 4vw, 5rem);
  padding-block: clamp(2.25rem, 1.75rem + 2.25vw, 3.75rem) clamp(0.75rem, 1.5vw, 1.5rem);
 }

 .hero__lede {
  font-size: var(--text-lg);
  line-height: 1.42;
  margin-block: 0.82rem 0.45rem;
  max-width: 36em;
 }

 .hero__location {
  max-width: 38em;
  margin-bottom: 1.05rem;
  color: var(--navy);
  font-size: 0.95rem;
  font-weight: 620;
 }

 .hero__booking-note {
  max-width: 38rem;
  margin-top: 0.72rem;
  color: var(--ink-soft);
  font-size: 0.98rem;
 }

 .hero__trust {
  list-style: none;
  padding: 0;
  margin-top: 1.2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem 1.8rem;
  font-size: 0.92rem;
  font-weight: 560;
  color: var(--ink);
 }

 .hero__trust li {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
 }

 .hero__trust li::before {
  content: '';
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--gold);
 }

 .hero__copy h1 {
  color: var(--navy);
  max-width: 9ch;
 }

 .hero__copy h1 span {
  display: block;
 }

 .hero__portrait {
  position: relative;
  margin: 0;
 }

 /* Signature detail: a thin gold frame offset behind the photo. */
 .hero__portrait::before {
  content: '';
  position: absolute;
  inset: 1rem -1rem -1rem 1rem;
  border: 2px solid var(--gold);
  border-radius: var(--radius-lg);
  opacity: 0.55;
 }

 .hero__portrait img {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: 74% 42%;
  border-radius: var(--radius-lg);
  box-shadow: 0 18px 42px -30px rgba(30, 53, 91, 0.42);
 }

 .audience-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
 }

 .how-strip {
  border-bottom: 1px solid var(--line);
  background: var(--surface-paper);
 }

 .how-strip__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
 }

 .how-strip__grid > div {
  display: grid;
  gap: 0.2rem;
  padding: 0.85rem clamp(0.85rem, 0.5rem + 0.8vw, 1.35rem);
  border-right: 1px solid var(--line);
 }

 .how-strip__grid > div:last-child {
  border-right: 0;
 }

 .how-strip__grid strong {
  color: var(--navy);
  font-size: 0.98rem;
 }

.how-strip__grid span {
  font-size: 0.88rem;
  color: var(--ink-soft);
 }

 .remote-card {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: clamp(1rem, 0.8rem + 1.2vw, 2rem);
  align-items: center;
  background: var(--surface-paper);
 }

 .remote-card h2 {
  font-size: var(--text-xl);
  margin-bottom: 0.45rem;
 }

 .remote-card__action {
  display: grid;
  gap: 0.6rem;
  justify-items: start;
  min-width: min(100%, 18rem);
 }

 .remote-card__action p {
  color: var(--ink-soft);
  font-size: 0.95rem;
 }

 .audience-card {
  display: flex;
  flex-direction: column;
  gap: 0.58rem;
  border-top: 3px solid var(--gold);
 }

 .audience-card h3 { font-size: var(--text-lg); }
 .audience-card p {
  font-size: 0.98rem;
  line-height: 1.48;
  flex-grow: 1;
 }

 .audience-card__link {
  font-size: 0.95rem;
  font-weight: 640;
  text-decoration: none;
 }

 .audience-card__link:hover { text-decoration: underline; }

 .services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
 }

 .not-tutoring {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: clamp(2rem, 1.5rem + 3vw, 5rem);
  align-items: start;
 }

 .not-tutoring__points {
  display: grid;
  gap: 1.05rem;
 }

 .not-tutoring__points h3 {
  color: var(--gold-soft);
  font-size: var(--text-lg);
  margin-bottom: 0.4rem;
 }

 .compass-section {
  display: grid;
  gap: clamp(1.5rem, 1.2rem + 1.45vw, 2.35rem);
 }

 .compass-intro {
  max-width: 48rem;
  text-align: center;
  margin-inline: auto;
 }

 .compass-logo-tile {
  display: grid;
  place-items: center;
  width: 5rem;
  height: 5rem;
  margin: 0 auto 1rem;
  padding: 0.55rem;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--white);
  box-shadow: var(--shadow-card);
 }

 .compass-intro .eyebrow {
  justify-content: center;
 }

 .compass-intro .lede {
  margin-inline: auto;
 }

 .compass-summary {
  margin: 0.72rem auto 0;
  color: var(--navy);
  font-weight: 680;
 }

 .compass-cycle {
  margin: 0.5rem auto 0;
  max-width: 44rem;
  font-size: 0.95rem;
 }

 .compass-steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.75rem;
 }

 .compass-steps li {
  display: grid;
  align-content: start;
  gap: 0.72rem;
  padding: clamp(1.05rem, 0.9rem + 0.65vw, 1.5rem);
  border: 1px solid var(--line);
  border-top: 3px solid var(--gold);
  border-radius: var(--radius-lg);
  background: var(--surface-white-strong);
  box-shadow: var(--shadow-card);
 }

 .compass-steps__num {
  font-size: 1.1rem;
  font-weight: 760;
  color: var(--gold);
  flex: none;
 }

 .compass-steps h3 {
  font-size: var(--text-lg);
 }

 .compass-steps p {
  font-size: 0.98rem;
  line-height: 1.48;
 }

 .compass-action {
  text-align: center;
 }

 .why-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: clamp(2rem, 1.5rem + 3vw, 5rem);
  align-items: center;
 }


 .why-points {
  display: grid;
  gap: 0.8rem;
  margin-block: 0.9rem 1.2rem;
 }

 .local-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
 }

 .local-card h3 {
  font-size: var(--text-lg);
  margin-bottom: 0.5rem;
 }

 .local-card p { font-size: 1rem; }

 .faq-preview {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: clamp(2rem, 1.5rem + 3vw, 4rem);
  align-items: start;
 }

 .faq-preview__more {
  margin-top: 1.05rem;
  font-weight: 600;
 }

 /* Responsive */
 @media (max-width: 960px) {
  .audience-grid,
  .services-grid,
  .local-grid {
