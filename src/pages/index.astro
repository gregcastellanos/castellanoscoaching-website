---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompassMark from '../components/CompassMark.astro';
import CompassDiagram from '../components/CompassDiagram.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqItem from '../components/FaqItem.astro';
import CtaBand from '../components/CtaBand.astro';
import { SERVICES, SITE } from '../data/site';
import { businessSchema } from '../data/schema';

const metaTitle =
  'Executive Function Coach in Marin County & the Bay Area | Castellanos Coaching';
const metaDescription =
  'Executive function, academic, social skills, and independence coaching for neurodivergent teens and adults. Based in Marin County, serving the North Bay, Sonoma County, Silicon Valley, and the Bay Area. Remote nationwide. Book a free consultation.';

const compassSteps = [
  {
    name: 'Clarity',
    body: 'We start by understanding how you actually work: strengths, sticking points, and goals in your own words. No one-size-fits-all program.',
  },
  {
    name: 'Alignment',
    body: 'Nothing works without trust and buy-in. Coaching feels like collaboration, not another adult telling you what to do.',
  },
  {
    name: 'Foundation',
    body: 'Together we build the practical layer: routines, systems, and habits that fit your brain and survive contact with real life.',
  },
  {
    name: 'Expansion',
    body: 'As the foundation holds, we widen the circle: more independence, more confidence, and momentum you can steer yourself.',
  },
];

const audiences = [
  {
    title: 'For parents',
    body: `You've watched a bright, capable kid struggle with school, motivation, or launching into adulthood. You're tired of being the planner, the alarm clock, and the enforcer. Coaching gives your teen a skilled mentor in their corner, and gives you your relationship back.`,
    link: { href: '/services/parent-family-coaching/', label: 'Parent & family coaching' },
  },
  {
    title: 'For teens & students',
    body: `You're not lazy and you're not broken. The systems you've been handed just weren't built for your brain. Coaching is a judgment-free space to figure out what actually works for you, from schoolwork to friendships to getting out the door on time.`,
    link: { href: '/services/academic-coaching/', label: 'Academic coaching' },
  },
  {
    title: 'For adults',
    body: `You're managing work, bills, relationships, and a brain that doesn't run on autopilot. Coaching offers practical structure and a thinking partner. No pathologizing and no lectures, just systems that hold up on your hardest days.`,
    link: { href: '/services/independence-life-skills-coaching/', label: 'Independence coaching' },
  },
];

const serviceIcons: Record<string, string> = {
  'executive-function-coaching':
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
  'academic-coaching':
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H20v13H6.5A2.5 2.5 0 0 0 4 19.5V19z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-2.5"/></svg>',
  'social-skills-coaching':
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12h.01M12 12h.01M16 12h.01"/><path d="M21 12a8.5 8.5 0 0 1-12.4 7.5L4 21l1.6-4.3A8.5 8.5 0 1 1 21 12z"/></svg>',
  'independence-life-skills-coaching':
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/></svg>',
  'parent-family-coaching':
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.9c0 5.4-7.5 10-7.5 10z"/></svg>',
};

const faqPreview = [
  {
    q: 'What is executive function coaching, exactly?',
    a: `Hands-on, individualized support for the skills that make daily life run: planning, starting tasks, managing time, staying organized, and following through. We don't just talk about these skills. We build real systems together and refine them until they hold.`,
  },
  {
    q: 'Is coaching therapy?',
    a: `No. Coaching is educational mentoring and skill-building, focused on practical action: what to do and how to actually do it. Many clients work with a therapist and a coach at the same time. The two complement each other well.`,
  },
  {
    q: 'Do you work in person or remotely?',
    a: `Both. Greg is based in Marin County and works in person across the North Bay, Sonoma County, San Francisco, Silicon Valley, and the greater Bay Area. Remote coaching is available nationwide and works well for most clients.`,
  },
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={businessSchema}>
  <!-- ============ Hero ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Neurodivergent coaching · Marin & the Bay Area · Remote nationwide</p>
        <h1 id="hero-title">
          Coaching for neurodivergent minds, <span class="hero__accent">built for real life.</span>
        </h1>
        <p class="hero__lede">
          Executive function, academic, social, and life skills coaching for
          teens and adults with ADHD, autism, and learning differences. Not
          tutoring and not therapy: a skilled mentor who helps you build
          systems, confidence, and real independence.
        </p>
        <div class="btn-row">
          <a href={SITE.calendly} class="btn btn--primary">Book a Free Consultation</a>
          <a href="/services/" class="btn btn--outline">Explore Coaching</a>
        </div>
        <ul class="hero__trust" aria-label="Credentials">
          <li>15+ years with neurodivergent learners</li>
          <li>Master's degree in Education</li>
          <li>In person & remote</li>
        </ul>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <CompassDiagram class="hero__compass" />
      </div>
    </div>
  </section>

  <!-- ============ Who we help ============ -->
  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who this is for</p>
        <h2 id="who-title">Bright, capable people. Systems that finally fit.</h2>
        <p class="lede">
          Castellanos Coaching works with neurodivergent teens, students, and
          adults, including those navigating ADHD, autism, anxiety, learning
          differences, low motivation, and school avoidance.
        </p>
      </div>
      <div class="audience-grid">
        {
          audiences.map((a) => (
            <div class="card audience-card">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
              <a href={a.link.href} class="audience-card__link">{a.link.label} →</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Services ============ -->
  <section class="section section--sand" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Coaching services</p>
        <h2 id="services-title">One coach. Five ways to build a life that works.</h2>
        <p class="lede">
          Every engagement is individualized. Most clients blend several of
          these, depending on what season of life they're in.
        </p>
      </div>
      <div class="services-grid">
        {
          SERVICES.map((s) => (
            <ServiceCard
              href={`/services/${s.slug}/`}
              title={s.title}
              description={s.short}
            >
              <Fragment set:html={serviceIcons[s.slug]} />
            </ServiceCard>
          ))
        }
        <div class="services-grid__cta">
          <CompassMark size={44} />
          <h3>Not sure where to start?</h3>
          <p>
            Most families aren't. Start with a free conversation and Greg will
            help you figure out what kind of support fits.
          </p>
          <a href="/contact/" class="btn btn--ink">Start with a Conversation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Not just tutoring ============ -->
  <section class="section section--ink" aria-labelledby="not-tutoring-title">
    <div class="wrap not-tutoring">
      <div>
        <p class="eyebrow">Why coaching</p>
        <h2 id="not-tutoring-title">This is not tutoring with a new label.</h2>
        <p class="lede">
          A tutor helps you pass Thursday's test. A coach helps you become
          someone who can plan the week, start the essay, talk to the teacher,
          and get to Thursday with energy left over.
        </p>
      </div>
      <div class="not-tutoring__points">
        <div>
          <h3>Skills, not answers</h3>
          <p>
            The goal is never dependence on the coach. Every system we build is
            designed to be run by you: planning, prioritizing, communicating,
            and recovering when things slip.
          </p>
        </div>
        <div>
          <h3>Strengths-based, not deficit-based</h3>
          <p>
            Neurodivergent brains aren't broken versions of typical ones. We
            start from what already works, like your interests, your energy
            patterns, and your way of thinking, and build from there.
          </p>
        </div>
        <div>
          <h3>Real life, not worksheets</h3>
          <p>
            Coaching happens where life happens: the actual backpack, the
            actual calendar, the actual job application, the actual
            conversation you've been avoiding.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Compass ============ -->
  <section class="section" aria-labelledby="compass-title">
    <div class="wrap compass-section">
      <div class="compass-section__visual">
        <CompassDiagram />
      </div>
      <div>
        <p class="eyebrow">The method</p>
        <h2 id="compass-title">The Castellanos Compass</h2>
        <p class="lede">
          A clear, flexible framework that keeps coaching honest and heading
          somewhere. Four points that every engagement moves through.
        </p>
        <ol class="compass-steps">
          {
            compassSteps.map((step, i) => (
              <li>
                <span class="compass-steps__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{step.name}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/castellanos-compass/" class="btn btn--outline">Explore the Compass</a>
      </div>
    </div>
  </section>

  <!-- ============ Why Greg ============ -->
  <section class="section section--sand" aria-labelledby="why-title">
    <div class="wrap why-grid">
      <div>
        <p class="eyebrow">Why families choose Greg</p>
        <h2 id="why-title">A mentor who gets it, and gets things moving</h2>
        <div class="why-points">
          <p>
            <strong>Deep, real experience.</strong> Greg has spent 15+ years
            teaching and coaching neurodivergent learners in classrooms, STEAM
            programs, and one-on-one, with a Master's degree in Education
            behind it.
          </p>
          <p>
            <strong>Respect first.</strong> Clients are never treated as
            problems to fix. Teens who have shut down with tutors and
            counselors often connect with Greg because he listens first and
            builds on what they care about.
          </p>
          <p>
            <strong>Practical to the core.</strong> Sessions end with something
            real: a system set up, a plan made, a conversation practiced, a
            hard task started. Progress you can point to.
          </p>
          <p>
            <strong>Partnership with parents.</strong> Families get honest
            communication and practical guidance. Support that lowers the
            temperature at home instead of adding another obligation.
          </p>
        </div>
        <a href="/about/" class="btn btn--ink">Meet Greg</a>
      </div>
      <div class="why-side">
        <figure class="why-photo">
          <img
            src="/greg.jpg"
            alt="Greg Castellanos, executive function and life skills coach"
            width="596"
            height="745"
            loading="lazy"
          />
        </figure>
        <figure class="testimonial card">
          <blockquote>
            “Greg helped me feel comfortable in my own skin. For the first
            time, I have real friends and the confidence to be myself.”
          </blockquote>
          <figcaption>Liam R., autistic learner</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ Local area ============ -->
  <section class="section" aria-labelledby="local-title">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">Where we work</p>
        <h2 id="local-title">Based in Marin. Available everywhere.</h2>
        <p class="lede">
          Castellanos Coaching is based in Marin County and works with
          families across the Bay Area in person. Remote coaching works just
          as well from anywhere in the country.
        </p>
      </div>
      <div class="local-grid">
        <div class="card local-card">
          <h3>Marin & the North Bay</h3>
          <p>
            In-person executive function and life skills coaching across Marin
            County, Sonoma County, and North Bay communities like Santa Rosa
            and Sebastopol.
          </p>
        </div>
        <div class="card local-card">
          <h3>San Francisco to Silicon Valley</h3>
          <p>
            ADHD and autism coaching for teens and adults in San Francisco,
            the Peninsula, Silicon Valley, and the greater Bay Area, in person
            or online.
          </p>
        </div>
        <div class="card local-card">
          <h3>Remote, nationwide</h3>
          <p>
            Video-based coaching with the same practical, individualized
            approach. A good fit for college students and adults anywhere in
            the U.S.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ preview ============ -->
  <section class="section section--sand" aria-labelledby="faq-title">
    <div class="wrap faq-preview">
      <div class="section-head">
        <p class="eyebrow">Good questions</p>
        <h2 id="faq-title">What parents and clients usually ask first</h2>
      </div>
      <div>
        {
          faqPreview.map((item) => (
            <FaqItem question={item.q}>
              <p>{item.a}</p>
            </FaqItem>
          ))
        }
        <p class="faq-preview__more">
          <a href="/faq/">Read all frequently asked questions →</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background:
      radial-gradient(52rem 30rem at 110% -10%, rgba(23, 102, 209, 0.09), transparent 65%),
      radial-gradient(44rem 26rem at -15% 110%, rgba(224, 169, 62, 0.12), transparent 65%),
      var(--mist);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(3.25rem, 2.5rem + 3.5vw, 6rem);
  }

  .hero__accent {
    color: var(--blue);
  }

  .hero__lede {
    font-size: var(--text-lg);
    line-height: 1.55;
    margin-block: 1.3rem 1.8rem;
    max-width: 34em;
  }

  .hero__trust {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--navy);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__trust li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold);
  }

  .hero__visual {
    display: grid;
    place-items: center;
  }

  .hero__compass,
  .compass-section__visual :global(svg) {
    width: min(100%, 25rem);
  }

  /* Audiences */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    border-top: 4px solid var(--gold);
  }

  .audience-card h3 { font-size: var(--text-lg); }
  .audience-card p { font-size: var(--text-base); flex-grow: 1; }

  .audience-card__link {
    font-size: 0.98rem;
    font-weight: 660;
    text-decoration: none;
  }

  .audience-card__link:hover { text-decoration: underline; }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .services-grid__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    justify-content: center;
    padding: clamp(1.4rem, 1.2rem + 1vw, 2.1rem);
    border-radius: var(--radius-lg);
    background: var(--sky);
    border: 1px dashed var(--blue);
  }

  .services-grid__cta svg { color: var(--blue-deep); }
  .services-grid__cta h3 { font-size: var(--text-lg); }
  .services-grid__cta p { font-size: var(--text-base); }

  /* Not-tutoring band */
  .not-tutoring {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 1.5rem + 3vw, 5rem);
    align-items: start;
  }

  .not-tutoring__points {
    display: grid;
    gap: 1.9rem;
  }

  .not-tutoring__points h3 {
    color: var(--gold);
    font-size: var(--text-lg);
    margin-bottom: 0.4rem;
  }

  /* Compass section */
  .compass-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 1.5rem + 3vw, 5rem);
    align-items: center;
  }

  .compass-section__visual {
    display: grid;
    place-items: center;
  }

  .compass-steps {
    list-style: none;
    padding: 0;
    margin-block: 1.9rem;
    display: grid;
    gap: 1.4rem;
  }

  .compass-steps li {
    display: flex;
    gap: 1.1rem;
    align-items: baseline;
  }

  .compass-steps__num {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--blue);
    flex: none;
  }

  .compass-steps h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .compass-steps p { font-size: var(--text-base); }

  /* Why Greg */
  .why-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 1.5rem + 3vw, 5rem);
    align-items: start;
  }

  .why-points {
    display: grid;
    gap: 1.2rem;
    margin-block: 1.5rem 2rem;
  }

  .why-side {
    display: grid;
    gap: 1.4rem;
    position: sticky;
    top: 6rem;
  }

  .why-photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--line);
    max-width: 22rem;
  }

  .why-photo img {
    width: 100%;
    object-fit: cover;
  }

  .testimonial {
    background: var(--navy);
    border-color: transparent;
    color: rgba(255, 255, 255, 0.92);
    max-width: 22rem;
  }

  .testimonial blockquote {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 520;
  }

  .testimonial figcaption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--gold-soft);
  }

  /* Local */
  .local-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .local-card h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.5rem;
  }

  .local-card p { font-size: var(--text-base); }

  /* FAQ preview */
  .faq-preview {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: start;
  }

  .faq-preview__more {
    margin-top: 1.5rem;
    font-weight: 640;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .audience-grid,
    .services-grid,
    .local-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 860px) {
    .hero__inner,
    .not-tutoring,
    .compass-section,
    .why-grid,
    .faq-preview {
      grid-template-columns: 1fr;
    }

    /* Headline leads on small screens; the compass is decoration. */
    .hero__visual { display: none; }
    .compass-section__visual { display: none; }

    .why-side {
      position: static;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .audience-grid,
    .services-grid,
    .local-grid,
    .why-side {
      grid-template-columns: 1fr;
    }
  }
</style>
