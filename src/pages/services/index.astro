---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICE_MODEL, SERVICES } from '../../data/site';
import { breadcrumbSchema } from '../../data/schema';

const metaTitle =
 'Coaching Services for Neurodivergent Minds | Castellanos';
const metaDescription = `Remote executive function, academic, social skills, independence, and family coaching for neurodivergent children, teens, and adults, with daytime scheduling and limited evening and in-person availability.`;

const details: Record<string, { who: string; points: string[] }> = {
 'executive-function-coaching': {
  who: 'Children, teens, students, and adults with ADHD, autism, or learning differences',
  points: [
   'Planning, prioritizing, and time management',
   'Task initiation and follow-through',
   'Organization systems that survive real life',
  ],
 },
 'academic-coaching': {
  who: 'Middle school through college students',
  points: [
   'Study systems built around how the student learns',
   'Workload management and motivation',
   'Self-advocacy with teachers and professors',
  ],
 },
 'social-skills-coaching': {
  who: 'Autistic and ADHD teens, young adults, and adults',
  points: [
   'Conversation, friendship, and dating',
   'Workplace communication and interviews',
   'Boundaries, energy, and building confidence to be yourself',
  ],
 },
 'independence-life-skills-coaching': {
  who: 'Young adults launching, and adults building sturdier routines',
  points: [
   'Daily structure, money basics, and home management',
   'Work, applications, and keeping the job',
   'Self-direction and real momentum',
  ],
 },
 'parent-family-coaching': {
  who: 'Parents and caregivers of neurodivergent teens and young adults',
  points: [
   'Lowering daily conflict during the hardest moments',
   'Strengthening cooperation and handing over ownership',
   'A staged, realistic plan toward independence',
  ],
 },
};

const jsonLd = breadcrumbSchema([
 { name: 'Home', path: '/' },
 { name: 'Services', path: '/services/' },
]);
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
 <PageHero
  eyebrow="Services"
 title="Practical coaching for real-life challenges"
  lede="Five focus areas. One practical approach. Most coaching happens remotely through Google Meet, with flexible daytime scheduling and limited evening and in-person availability."
 />

 <section class="section">
  <div class="wrap">
   <div class="service-rows">
    {
     SERVICES.map((s, i) => (
      <article class="service-row card" id={s.slug}>
       <div class="service-row__main">
        <p class="service-row__num" aria-hidden="true">
         {String(i + 1).padStart(2, '0')}
        </p>
        <h2>
         <a href={`/services/${s.slug}/`}>{s.title}</a>
        </h2>
        <p class="service-row__short">{s.short}</p>
        <p class="service-row__who">
         <strong>Best fit:</strong> {details[s.slug].who}
        </p>
       </div>
       <div class="service-row__side">
        <ul class="check-list">
         {details[s.slug].points.map((p) => (
          <li>{p}</li>
         ))}
        </ul>
        <a class="btn btn--outline" href={`/services/${s.slug}/`}>
         About this coaching
        </a>
       </div>
      </article>
     ))
    }
   </div>

   <div class="services-note">
    <h2>How engagements work</h2>
    <p>
     Coaching starts with a free consultation, then usually runs as weekly
     one-on-one sessions. Every engagement follows
     <a href="/castellanos-compass/">The Castellanos Compass™</a>:
     Clarity, Alignment, Foundation, and Expansion.
    </p>
   </div>
  </div>
 </section>

 <section class="section section--sand" aria-labelledby="sessions-title">
  <div class="wrap">
   <div class="section-head">
    <p class="eyebrow">How sessions work</p>
    <h2 id="sessions-title">Remote, practical, and built around real life</h2>
    <p class="lede">
     {SERVICE_MODEL.summary}
    </p>
   </div>
   <div class="session-grid">
    <div class="card session-card">
     <h3>Remote by default</h3>
     <p>
      Most sessions are conducted remotely through Google Meet. Remote
      coaching lets Gregory work consistently on executive functioning,
      independence, social skills, academics, employment, and real-life
      problem solving from wherever the client is most comfortable.
     </p>
    </div>
    <div class="card session-card">
     <h3>Daytime works well</h3>
     <p>
      Daytime sessions are often a strong fit for young adults, college
      students, homeschool students, clients with flexible schedules, and
      parents who are available during the workday.
     </p>
    </div>
    <div class="card session-card">
     <h3>Limited evenings and in person</h3>
     <p>
      Limited evening and in-person coaching may be available depending on
      client needs, location, and scheduling availability.
     </p>
    </div>
   </div>
  </div>
 </section>

 <CtaBand
  title="Not sure which service fits?"
  body={`That is normal. Schedule a free consultation and Gregory will help you figure out where to start.`}
 />
</BaseLayout>

<style>
 .service-rows {
  display: grid;
  gap: 1.05rem;
 }

 .service-row {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: clamp(1.2rem, 0.9rem + 1.55vw, 2.35rem);
  align-items: center;
 }

 .service-row__num {
  font-size: 1rem;
  font-weight: 760;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 0.28rem;
 }

 .service-row h2 {
  font-size: var(--text-xl);
  margin-bottom: 0.42rem;
 }

 .service-row h2 a {
  color: var(--ink);
  text-decoration: none;
 }

 .service-row h2 a:hover {
  color: var(--gold-deep);
 }

 .service-row__short {
  margin-bottom: 0.55rem;
 }

 .service-row__who {
  font-size: 0.95rem;
 }

 .service-row__side {
  display: grid;
  gap: 0.9rem;
  justify-items: start;
 }

 .service-row__side .check-list {
  font-size: 0.98rem;
 }

 .services-note {
  margin-top: clamp(1.25rem, 1.05rem + 1vw, 2.25rem);
  padding: clamp(1.05rem, 0.9rem + 0.65vw, 1.55rem);
  background: var(--surface-paper);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
 }

 .services-note h2 {
  font-size: var(--text-lg);
  margin-bottom: 0.4rem;
 }

 .session-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.85rem;
 }

 .session-card h3 {
  font-size: var(--text-lg);
  margin-bottom: 0.4rem;
 }

 .session-card p {
  font-size: 1rem;
 }

 @media (max-width: 760px) {
  .service-row,
  .session-grid {
   grid-template-columns: 1fr;
  }
 }
</style>
