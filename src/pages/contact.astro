---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { BOOKING, SERVICE_MODEL, SITE } from '../data/site';
import { breadcrumbSchema, businessSchema } from '../data/schema';

const metaTitle =
 'Book a Free Consultation | Castellanos Coaching, Marin CA';
const metaDescription = `Book a free 20-30 minute consultation with Gregory Castellanos. Coaching for Marin, Bay Area, and Northern California families, held remotely.`;

const jsonLd = [
 businessSchema,
 breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
 ]),
];

const emailSubject = encodeURIComponent('Coaching consultation inquiry');
const emailBody = encodeURIComponent(
 `Hi Gregory,

I'm interested in a free consultation.

A little about our situation:
- Who the coaching would be for (age, and anything relevant like ADHD/autism/learning differences):
- What's feeling hardest right now (school, work, independence, social, home):
- Location, city or remote:
- Best way and time to reach me:

Thanks!`
);
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
 <PageHero
  eyebrow="Contact"
  title="Start with a conversation"
  lede="A free 20–30 minute consultation. Most consultations are remote through Google Meet, with daytime and limited evening appointments available."
 />

 <section class="section">
  <div class="wrap contact-grid">
   <div class="contact-options">
    <div class="card contact-card contact-card--primary">
     <h2>Schedule a free consultation</h2>
     <p>
      Schedule a free consultation to discuss your needs, ask questions,
      and determine whether Castellanos Coaching is a good fit.
     </p>
     <p>Most consultations are held remotely through Google Meet. Daytime and limited evening appointments are available.</p>
     <p class="contact-card__reassurance">{BOOKING.reassurance}</p>
     <a
      href={BOOKING.url}
      class="btn btn--primary"
      target={BOOKING.target}
      rel={BOOKING.rel}
      data-sticky-cta-anchor
      aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
     >
    </div>

    <div class="card contact-card">
     <h2>Call or text</h2>
     <p>
      Reach Gregory directly. If he is in session, he will get back to you.
     </p>
     <a href={SITE.phoneHref} class="btn btn--outline">{SITE.phone}</a>
    </div>

    <div class="card contact-card">
     <h2>General email inquiry</h2>
     <p>
      Prefer to write first, ask a question, or share context before scheduling?
      This starts an email with a few prompts.
     </p>
     <a
      href={`mailto:${SITE.email}?subject=${emailSubject}&body=${emailBody}`}
      class="btn btn--outline">Email Gregory</a
     >
     <p class="contact-card__addr">{SITE.email}</p>
    </div>
   </div>

   <aside class="contact-aside">
    <div class="contact-expect card">
     <h2>What happens next</h2>
     <ol>
      <li>
       <strong>You reach out.</strong> Online, phone, or email, a
       sentence or two is plenty.
      </li>
      <li>
       <strong>We talk for 20–30 minutes.</strong> What's going on, what
       you've tried, what you're hoping changes.
      </li>
      <li>
       <strong>You get an honest read.</strong> Whether coaching fits,
       where to start, and what it costs.
      </li>
     </ol>
    </div>

    <div class="contact-area">
     <h2>Service area</h2>
     <p>
      <strong>Remote:</strong> {SERVICE_MODEL.remote}
     </p>
     <p><strong>In person:</strong> {SERVICE_MODEL.inPerson}</p>
     <p><strong>Scheduling:</strong> {SERVICE_MODEL.scheduling}</p>
     <p class="contact-area__note">
      Teens and young adults: it is fine if a parent reaches out first.
      It is also fine if you want to reach out yourself.
     </p>
    </div>
   </aside>
  </div>
 </section>
 <CtaBand />
</BaseLayout>

<style>
 .contact-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(1.35rem, 1rem + 1.55vw, 3rem);
  align-items: start;
 }

 .contact-options {
  display: grid;
  gap: 0.9rem;
 }

 .contact-card {
  display: grid;
  gap: 0.65rem;
  justify-items: start;
 }

 .contact-card--primary {
  background: var(--navy);
  border-color: transparent;
  color: rgba(250, 247, 241, 0.85);
 }

 .contact-card--primary h2 {
  color: var(--cream);
 }

 .contact-card h2 {
  font-size: var(--text-lg);
 }

 .contact-card__addr {
  font-size: 0.92rem;
  color: var(--ink-soft);
 }

 .contact-card__reassurance {
  color: rgba(255, 255, 255, 0.82);
  font-size: 0.95rem;
 }

 .contact-card--primary .btn--primary {
  background: var(--white);
  color: var(--navy);
  box-shadow: 0 16px 34px -24px rgba(0, 0, 0, 0.42);
 }

 .contact-card--primary .btn--primary:hover {
  background: var(--navy-soft);
  color: var(--navy);
 }

 .contact-expect ol {
  padding-left: 1.2rem;
  display: grid;
  gap: 0.65rem;
  margin: 0;
 }

 .contact-expect h2,
 .contact-area h2 {
  font-size: var(--text-lg);
  margin-bottom: 0.7rem;
 }

 .contact-expect {
  margin-bottom: 1.15rem;
  background: var(--surface-paper);
  border-color: transparent;
 }

 .contact-area p + p {
  margin-top: 0.6rem;
 }

 .contact-area__note {
  margin-top: 0.9rem !important;
  padding: 0.85rem 1rem;
  background: var(--surface-paper);
  border-radius: var(--radius);
  font-size: 0.95rem;
 }

 @media (max-width: 800px) {
  .contact-grid {
   grid-template-columns: 1fr;
  }
 }
</style>
