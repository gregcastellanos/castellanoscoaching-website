---
import { BOOKING, NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
 href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
 <div class="wrap site-header__inner">
  <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
   <img
    src="/castellanos-coaching-logo.png"
    alt=""
    width="1523"
    height="415"
    aria-hidden="true"
   />
  </a>

  <button
   class="nav-toggle"
   type="button"
   aria-expanded="false"
   aria-controls="site-nav"
  >
   <span class="nav-toggle__bar" aria-hidden="true"></span>
   <span class="nav-toggle__label">Menu</span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label="Main">
   <ul>
    {
     NAV.map((item) => (
      <li>
       <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
       >
        {item.label}
       </a>
      </li>
     ))
    }
    <li class="site-nav__cta">
     <a
      href={BOOKING.url}
      class="btn btn--primary"
      target={BOOKING.target}
      rel={BOOKING.rel}
      aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
     >
    </li>
    <li class="site-nav__phone">
     <a href={SITE.phoneHref}>Or call {SITE.phone}</a>
    </li>
   </ul>
  </nav>
 </div>
</header>

<script>
 const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
 const nav = document.getElementById('site-nav');
 toggle?.addEventListener('click', () => {
  const open = toggle.getAttribute('aria-expanded') === 'true';
  toggle.setAttribute('aria-expanded', String(!open));
  nav?.classList.toggle('is-open', !open);
  document.body.classList.toggle('nav-open', !open);
 });
 document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
   toggle.setAttribute('aria-expanded', 'false');
   nav?.classList.remove('is-open');
   document.body.classList.remove('nav-open');
   toggle.focus();
  }
 });
</script>

<style>
 .site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
 }

 .site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.9rem;
  padding-block: 0.56rem;
 }

 .brand {
 display: flex;
 align-items: center;
  width: clamp(15.9rem, 21vw, 19rem);
  min-width: 15.9rem;
  height: 4.2rem;
  overflow: visible;
  text-decoration: none;
 }

 .brand img {
 width: 100%;
 max-width: 100%;
  max-height: 4rem;
  height: auto;
  object-fit: contain;
 }

 .site-nav ul {
 display: flex;
 align-items: center;
  gap: clamp(0.75rem, 0.45rem + 0.65vw, 1.35rem);
  list-style: none;
  margin: 0;
  padding: 0;
 }

 .site-nav a:not(.btn) {
  font-family: var(--font-display);
  font-size: 0.92rem;
  font-weight: 610;
  color: var(--ink);
  text-decoration: none;
  padding-block: 0.4rem;
  border-bottom: 2px solid transparent;
 }

 .site-nav a:not(.btn):hover {
  color: var(--gold-deep);
 }

 .site-nav a[aria-current='page'] {
  border-bottom-color: var(--gold);
 }

 .site-nav .btn {
  min-height: 2.65rem;
  padding: 0.58rem 1.05rem;
  font-size: 0.9rem;
 }

 /* Tap-to-call is a mobile affordance; hide it in the desktop bar. */
 .site-nav__phone {
  display: none;
 }

 .nav-toggle {
  display: none;
  align-items: center;
  gap: 0.6rem;
  background: none;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.55rem 1.1rem;
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 620;
  color: var(--ink);
  cursor: pointer;
 }

 .nav-toggle__bar {
  position: relative;
  width: 18px;
  height: 2px;
  background: var(--ink);
  border-radius: 2px;
 }

 .nav-toggle__bar::before,
 .nav-toggle__bar::after {
  content: '';
  position: absolute;
  left: 0;
  width: 18px;
  height: 2px;
  background: var(--ink);
  border-radius: 2px;
  transition: transform 0.2s ease;
 }

 .nav-toggle__bar::before { top: -6px; }
 .nav-toggle__bar::after { top: 6px; }

 .nav-toggle[aria-expanded='true'] .nav-toggle__bar { background: transparent; }
 .nav-toggle[aria-expanded='true'] .nav-toggle__bar::before { transform: translateY(6px) rotate(45deg); }
 .nav-toggle[aria-expanded='true'] .nav-toggle__bar::after { transform: translateY(-6px) rotate(-45deg); }

 @media (max-width: 860px) {
  .brand {
   width: clamp(11.6rem, 54vw, 14.2rem);
   min-width: 0;
   height: 3.55rem;
  }

  .brand img {
   max-height: 3.45rem;
  }

  .nav-toggle { display: inline-flex; }

  .site-nav {
   display: none;
   position: absolute;
   inset: 100% 0 auto 0;
   background: var(--surface-white-strong);
   backdrop-filter: blur(14px);
   border-bottom: 1px solid var(--line);
   box-shadow: var(--shadow-lift);
   padding: 0.75rem 1.25rem 1.5rem;
   max-height: calc(100dvh - 4.5rem);
   overflow-y: auto;
  }

  .site-nav.is-open { display: block; }

  .site-nav ul {
   flex-direction: column;
   align-items: stretch;
   gap: 0;
  }

  .site-nav a:not(.btn) {
   display: block;
   padding: 0.9rem 0.25rem;
   font-size: 1.05rem;
   border-bottom: 1px solid var(--line);
  }

  .site-nav a[aria-current='page'] {
   border-bottom-color: var(--gold);
  }

  .site-nav__cta {
   margin-top: 1.25rem;
  }

  .site-nav__phone {
   display: block;
   text-align: center;
   margin-top: 0.9rem;
  }

  .site-nav__phone a {
   display: inline-block;
   padding: 0.4rem 0.25rem;
   font-size: 1rem;
   font-weight: 600;
   color: var(--gold-deep);
   text-decoration: none;
   border-bottom: none;
  }

  .site-nav .btn {
   width: 100%;
   padding: 0.9rem 1.25rem;
   font-size: 1rem;
  }
 }
</style>
