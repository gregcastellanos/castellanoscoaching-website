---
interface Props {
 eyebrow?: string;
 title: string;
 lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="page-hero">
 <div class="wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1><Fragment set:html={title} /></h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
 </div>
</div>

<style>
 .page-hero {
  background: var(--white);
  border-bottom: 1px solid var(--line);
  padding-block: clamp(3.25rem, 2.5rem + 3vw, 5.75rem);
 }

 .page-hero h1 {
  font-size: var(--text-3xl);
  max-width: 46rem;
 }

 .page-hero .lede {
  max-width: 42rem;
 }
</style>
