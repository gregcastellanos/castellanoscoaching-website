---
// Interior-page hero: eyebrow + title + lede on a warm sand band.
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="page-hero">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>

<style>
  .page-hero {
    background:
      radial-gradient(48rem 24rem at 85% -20%, rgba(224, 169, 62, 0.16), transparent 70%),
      var(--mist);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .page-hero h1 {
    font-size: var(--text-3xl);
    max-width: 46rem;
  }

  .page-hero .lede {
    max-width: 42rem;
  }
</style>
