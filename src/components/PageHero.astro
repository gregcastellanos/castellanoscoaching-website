---
import HillsDivider from './HillsDivider.astro';

interface Props {
 eyebrow?: string;
 title: string;
 lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="page-hero">
 <div class="wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1><Fragment set:html={title} /></h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
 </div>
 <HillsDivider />
</div>

<style>
 .page-hero {
  background: var(--white);
  border-bottom: 1px solid var(--line);
  padding-top: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
 }

 .page-hero .wrap {
  margin-bottom: clamp(1rem, 2.5vw, 2rem);
 }

 .page-hero h1 {
  font-size: var(--text-3xl);
  max-width: 46rem;
 }

 .page-hero .lede {
  max-width: 42rem;
 }
</style>
