---
import CompassMark from './CompassMark.astro';
import { BOOKING, SITE } from '../data/site';

interface Props {
 title?: string;
 body?: string;
}

const {
 title = 'Start with a conversation.',
 body = `A free 20–30 minute call. No pressure. Just a clear conversation about what is going on and where to start.`,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
 <div class="wrap cta-band__inner">
  <span class="cta-band__logo-tile">
   <CompassMark size={56} class="cta-band__mark" />
  </span>
  <h2 id="cta-band-title"><Fragment set:html={title} /></h2>
  <p>{body}</p>
  <p class="cta-band__reassurance">{BOOKING.reassurance}</p>
  <div class="btn-row cta-band__buttons">
   <a
    href={BOOKING.url}
    class="btn btn--primary"
    target={BOOKING.target}
    rel={BOOKING.rel}
    aria-label={BOOKING.ariaLabel}>{BOOKING.label}</a
   >
   <a href={SITE.phoneHref} class="btn btn--outline">Call {SITE.phone}</a>
  </div>
  <p class="cta-band__alt">
   Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
 </div>
</section>

<style>
 .cta-band {
  background: var(--surface-white);
  color: var(--ink-soft);
  text-align: center;
  padding-block: clamp(2rem, 1.6rem + 1.55vw, 3.15rem);
  border-top: 1px solid var(--line);
 }

 .cta-band__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.65rem;
 }

 .cta-band__logo-tile {
  display: grid;
  place-items: center;
  width: 4.75rem;
  height: 4.75rem;
  padding: 0.55rem;
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 16px;
  background: var(--white);
  box-shadow: var(--shadow-card);
 }

 .cta-band h2 {
  color: var(--navy);
  font-size: var(--text-2xl);
 }

 .cta-band p {
  max-width: 38rem;
  font-size: var(--text-md);
 }

 .cta-band__buttons {
  justify-content: center;
  width: fit-content;
  max-width: 100%;
  margin-inline: auto;
  margin-top: 0.25rem;
 }

 .cta-band__alt {
  font-size: 0.95rem;
  color: var(--ink-soft);
 }

 .cta-band__reassurance {
  font-size: 0.98rem;
  color: var(--ink-soft);
 }

 .cta-band__alt a {
  color: var(--gold-deep);
 }

 @media (max-width: 640px) {
  .cta-band__buttons {
   width: min(100%, 22rem);
  }

  .cta-band__buttons .btn {
   width: 100%;
  }
 }
</style>
