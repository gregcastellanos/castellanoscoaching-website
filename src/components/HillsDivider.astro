---
// Gentle California-hills graphic: three layered ridgelines that drift
// slowly at different speeds (parallax), with a soft gold sun. Pure CSS
// animation, no JS; sits in normal flow at the bottom of a hero.
// Respects prefers-reduced-motion via the global animation kill-switch.
---

<div class="hills" aria-hidden="true">
 <svg class="hills__sun" viewBox="0 0 100 100">
  <circle cx="50" cy="50" r="34" fill="var(--gold)" opacity="0.28" />
  <circle cx="50" cy="50" r="22" fill="var(--gold)" opacity="0.35" />
 </svg>

 <div class="hills__layer hills__layer--back">
  <svg viewBox="0 0 2880 120" preserveAspectRatio="none">
   <path d="M0 70 C240 30 460 26 700 58 C940 92 1180 38 1440 70 L1440 120 L0 120 Z" fill="#e8eff7" />
   <path d="M0 70 C240 30 460 26 700 58 C940 92 1180 38 1440 70 L1440 120 L0 120 Z" fill="#e8eff7" transform="translate(1440 0)" />
  </svg>
 </div>

 <div class="hills__layer hills__layer--mid">
  <svg viewBox="0 0 2880 120" preserveAspectRatio="none">
   <path d="M0 88 C260 54 520 96 780 74 C1040 52 1240 96 1440 88 L1440 120 L0 120 Z" fill="#dbe6f2" />
   <path d="M0 88 C260 54 520 96 780 74 C1040 52 1240 96 1440 88 L1440 120 L0 120 Z" fill="#dbe6f2" transform="translate(1440 0)" />
  </svg>
 </div>

 <div class="hills__layer hills__layer--front">
  <svg viewBox="0 0 2880 120" preserveAspectRatio="none">
   <path d="M0 102 C200 78 420 108 700 92 C980 76 1200 110 1440 102 L1440 120 L0 120 Z" fill="#ccdcee" />
   <path d="M0 102 C200 78 420 108 700 92 C980 76 1200 110 1440 102 L1440 120 L0 120 Z" fill="#ccdcee" transform="translate(1440 0)" />
  </svg>
 </div>
</div>

<style>
 .hills {
  position: relative;
  height: clamp(3.25rem, 7vw, 5.5rem);
  overflow: hidden;
  pointer-events: none;
 }

 .hills__sun {
  position: absolute;
  left: clamp(1rem, 12vw, 14rem);
  bottom: 28%;
  width: clamp(3rem, 6vw, 4.5rem);
  height: auto;
 }

 .hills__layer {
  position: absolute;
  inset: 0;
  width: 200%;
  animation: hills-drift linear infinite;
 }

 .hills__layer svg {
  width: 100%;
  height: 100%;
 }

 .hills__layer--back { animation-duration: 110s; }
 .hills__layer--mid { animation-duration: 80s; }
 .hills__layer--front { animation-duration: 60s; }

 @keyframes hills-drift {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
 }
</style>
