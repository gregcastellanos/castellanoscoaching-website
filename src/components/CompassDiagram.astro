---
// The Castellanos Compass: four-point framework rendered as an SVG rose
// with labeled points. Decorative; the surrounding text carries meaning.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 420 420"
  role="img"
  aria-label="The Castellanos Compass: Clarity at north, Alignment at east, Foundation at south, Expansion at west"
>
  <defs>
    <linearGradient id="rose" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1766d1" />
      <stop offset="1" stop-color="#0d2b45" />
    </linearGradient>
  </defs>

  <!-- outer rings -->
  <circle cx="210" cy="210" r="196" fill="none" stroke="var(--line, #d8e2ec)" stroke-width="1.5" />
  <circle cx="210" cy="210" r="150" fill="none" stroke="var(--line, #d8e2ec)" stroke-width="1" stroke-dasharray="3 7" />

  <!-- tick marks -->
  <g stroke="var(--gold, #e0a93e)" stroke-width="2.5" opacity="0.9">
    <line x1="210" y1="14" x2="210" y2="30" />
    <line x1="210" y1="390" x2="210" y2="406" />
    <line x1="14" y1="210" x2="30" y2="210" />
    <line x1="390" y1="210" x2="406" y2="210" />
  </g>

  <!-- rose -->
  <path
    d="M210 68 L232 188 L352 210 L232 232 L210 352 L188 232 L68 210 L188 188 Z"
    fill="url(#rose)"
    opacity="0.12"
  />
  <path
    d="M210 96 L226 194 L324 210 L226 226 L210 324 L194 226 L96 210 L194 194 Z"
    fill="url(#rose)"
  />
  <circle cx="210" cy="210" r="10" fill="var(--gold, #e0a93e)" />
  <circle cx="210" cy="210" r="4" fill="#fff" />

  <!-- labels -->
  <g
    font-family="Bricolage Grotesque Variable, Avenir Next, sans-serif"
    font-size="18"
    font-weight="650"
    fill="var(--navy, #0d2b45)"
    text-anchor="middle"
  >
    <text x="210" y="52">Clarity</text>
    <text x="210" y="384">Foundation</text>
    <text x="362" y="192">Alignment</text>
    <text x="58" y="192">Expansion</text>
  </g>
  <g
    font-family="Bricolage Grotesque Variable, Avenir Next, sans-serif"
    font-size="12"
    font-weight="650"
    letter-spacing="2"
    fill="var(--blue-deep, #0f4da8)"
    text-anchor="middle"
  >
    <text x="210" y="34">N</text>
    <text x="210" y="416">S</text>
    <text x="399" y="215">E</text>
    <text x="21" y="215">W</text>
  </g>
</svg>
