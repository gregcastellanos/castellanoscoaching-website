---
// The Castellanos Compass: four-point framework rendered as an SVG rose
// with labeled points. Decorative — the surrounding text carries meaning.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 420 420"
  role="img"
  aria-label="The Castellanos Compass: Clarity at north, Alignment at east, Foundation at south, Expansion at west"
>
  <defs>
    <linearGradient id="rose" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#c9a35c" />
      <stop offset="1" stop-color="#b25438" />
    </linearGradient>
  </defs>

  <!-- outer rings -->
  <circle cx="210" cy="210" r="196" fill="none" stroke="var(--line, #e3dac9)" stroke-width="1.5" />
  <circle cx="210" cy="210" r="150" fill="none" stroke="var(--line, #e3dac9)" stroke-width="1" stroke-dasharray="3 7" />

  <!-- tick marks -->
  <g stroke="var(--gold, #c9a35c)" stroke-width="2" opacity="0.7">
    <line x1="210" y1="14" x2="210" y2="30" />
    <line x1="210" y1="390" x2="210" y2="406" />
    <line x1="14" y1="210" x2="30" y2="210" />
    <line x1="390" y1="210" x2="406" y2="210" />
  </g>

  <!-- rose -->
  <path
    d="M210 68 L232 188 L352 210 L232 232 L210 352 L188 232 L68 210 L188 188 Z"
    fill="url(#rose)"
    opacity="0.14"
  />
  <path
    d="M210 96 L226 194 L324 210 L226 226 L210 324 L194 226 L96 210 L194 194 Z"
    fill="url(#rose)"
    opacity="0.9"
  />
  <circle cx="210" cy="210" r="10" fill="var(--ink, #21313c)" />
  <circle cx="210" cy="210" r="4" fill="var(--cream, #faf7f1)" />

  <!-- labels -->
  <g
    font-family="Inter Variable, sans-serif"
    font-size="17"
    font-weight="650"
    fill="var(--ink, #21313c)"
    text-anchor="middle"
  >
    <text x="210" y="52">Clarity</text>
    <text x="210" y="382">Foundation</text>
    <text x="365" y="192">Alignment</text>
    <text x="56" y="192">Expansion</text>
  </g>
  <g
    font-family="Inter Variable, sans-serif"
    font-size="12"
    font-weight="600"
    letter-spacing="2"
    fill="var(--clay-deep, #96432a)"
    text-anchor="middle"
  >
    <text x="210" y="34">N</text>
    <text x="210" y="416">S</text>
    <text x="399" y="215">E</text>
    <text x="21" y="215">W</text>
  </g>
</svg>
