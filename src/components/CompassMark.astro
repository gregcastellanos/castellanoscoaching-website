---
// The brand mark: a four-point compass rose. Decorative wherever it appears.
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
>
  <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.6" opacity="0.45" />
  <path d="M24 4 L28.5 19.5 L44 24 L28.5 28.5 L24 44 L19.5 28.5 L4 24 L19.5 19.5 Z" fill="currentColor" opacity="0.92" />
  <circle cx="24" cy="24" r="3.4" fill="var(--gold, #c9a35c)" />
</svg>
