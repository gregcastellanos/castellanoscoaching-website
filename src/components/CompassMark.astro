---
interface Props {
 size?: number;
 class?: string;
}
const { size = 34, class: className } = Astro.props;
---

<span
 class:list={['compass-mark', className]}
 style={`--mark-size: ${size}px`}
 aria-hidden="true"
>
 <img src="/castellanos-compass-logo.png" alt="" width="997" height="1097" />
</span>

<style>
 .compass-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--mark-size);
  height: var(--mark-size);
  flex: none;
 }

 .compass-mark img {
  width: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
 }
</style>
